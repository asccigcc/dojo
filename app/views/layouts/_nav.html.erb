<header class="border-b border-slate-200 bg-white">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <div class="flex items-center gap-6">
      <%= link_to t("app.name"), root_path, class: "text-lg font-bold text-indigo-700" %>
      <% if current_user %>
        <%= link_to t(".today"), root_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
        <%= link_to t(".catalog"), exercises_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
      <% end %>
    </div>
    <% if current_user %>
      <div class="flex items-center gap-3 text-sm">
        <span class="text-slate-600"><%= current_user.name %></span>
        <%= button_to t(".sign_out"), session_path, method: :delete, class: "btn-secondary" %>
      </div>
    <% end %>
  </nav>
</header>
